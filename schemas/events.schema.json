{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "events.json and data/events.yaml",
  "type": "object",
  "required": ["items"],
  "properties": {
    "as_of": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company", "date", "type", "title"],
        "properties": {
          "company": {"type": "string"},
          "date": {"type": "string", "format": "date"},
          "type": {"type": "string", "enum": ["results", "agm", "capital_markets_day", "deal", "other"]},
          "title": {"type": "string"},
          "confirmed": {"type": "boolean", "default": false},
          "source_url": {"type": ["string", "null"]}
        }
      }
    }
  }
}
