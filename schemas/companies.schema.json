{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "companies.schema.json",
  "title": "companies.json (display subset of config/watchlist.yaml)",
  "type": "object",
  "required": ["as_of", "companies"],
  "properties": {
    "as_of": {"type": "string", "format": "date-time"},
    "benchmark": {
      "type": "object",
      "description": "Chart reference series from dashboard.benchmark; not a company.",
      "required": ["symbol", "name"],
      "properties": {
        "symbol": {"type": "string"},
        "name": {"type": "string"}
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "name", "ticker", "exchange", "currency", "color"],
        "properties": {
          "code": {"type": "string"},
          "name": {"type": "string"},
          "ticker": {"type": "string"},
          "exchange": {"type": "string"},
          "currency": {"type": "string"},
          "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
        }
      }
    }
  }
}
